<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The Components.Testing App host is marked [RequiresPreviewFeatures] in .NET 11. -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Testing" Version="11.0.0-preview.7.26504.105" />
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The E2EApp metadata tells the testing infrastructure to manage this app
         (build/publish + manifest entry) so the fixture can launch it as an
         out-of-process server behind YARP. -->
    <ProjectReference Include="..\BlazorFeatures\BlazorFeatures.csproj">
      <E2EApp>true</E2EApp>
    </ProjectReference>
  </ItemGroup>

</Project>
