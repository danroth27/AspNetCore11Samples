<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Server.AutoPause" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skip designer codegen; values are looked up by name via IStringLocalizer<ValidationMessages>. -->
    <EmbeddedResource Update="Resources\ValidationMessages.resx" GenerateSource="false" />
    <EmbeddedResource Update="Resources\ValidationMessages.*.resx" GenerateSource="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedComponents\SharedComponents.csproj" />
    <ProjectReference Include="..\AspNetCore11Samples.ServiceDefaults\AspNetCore11Samples.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
