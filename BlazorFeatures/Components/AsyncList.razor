@* Models async load state as a single closed union instead of the usual
   (bool _loading; T? _data; string? _error) fields. Rendering switches over the
   one value, so illegal combinations (loading AND failed) can't be represented. *@
@using BlazorFeatures.Models

<div class="border rounded p-3">
    @switch (_state)
    {
        case Loading:
            <p class="text-muted mb-0"><em>Loading…</em></p>
            break;
        case Loaded loaded:
            <ul class="mb-0">
                @foreach (var item in loaded.Items)
                {
                    <li>@item</li>
                }
            </ul>
            break;
        case Failed failed:
            <div class="alert alert-danger mb-0">@failed.Message</div>
            break;
    }
</div>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => LoadAsync(fail: false)">Reload</button>
    <button class="btn btn-outline-danger" @onclick="() => LoadAsync(fail: true)">Reload (simulate failure)</button>
</div>

@code {
    private LoadState _state = new Loading();

    protected override Task OnInitializedAsync() => LoadAsync(fail: false);

    private async Task LoadAsync(bool fail)
    {
        _state = new Loading();
        await Task.Delay(400);
        _state = fail
            ? new Failed("Couldn't reach the inventory service (HTTP 503).")
            : new Loaded(new[] { "Widget #42", "Gadget #7", "Sprocket #13" });
    }
}
