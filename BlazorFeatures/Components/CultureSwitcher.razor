@inject Microsoft.Extensions.Localization.IStringLocalizer<BlazorFeatures.Resources.ValidationMessages> L
@inject NavigationManager Nav

@* data-enhance-nav="false" forces a full page load for these links. Blazor establishes
   the circuit's culture when the circuit starts, and enhanced navigation reuses the
   existing circuit -- so /Culture/Set would write the cookie and redirect back, but the
   interactive components would keep rendering in the culture the circuit started with.
   A full reload is the documented way to switch culture (the NavigationManager
   equivalent is NavigateTo(..., forceLoad: true)). See:
   https://learn.microsoft.com/aspnet/core/blazor/globalization-localization *@
<div class="culture-switcher" data-enhance-nav="false">
    <span class="culture-label">@L["LanguageLabel"]:</span>
    <a href="@SetCultureHref("en-US")">English</a>
    <span> | </span>
    <a href="@SetCultureHref("es-ES")">Espa&#241;ol</a>
</div>

@code {
    private string SetCultureHref(string culture)
    {
        var uri = new Uri(Nav.Uri);
        var redirect = Uri.EscapeDataString(uri.PathAndQuery);
        return $"/Culture/Set?culture={culture}&redirectUri={redirect}";
    }
}
