@page "/navigation-features/get-uri-with-hash"
@inject NavigationManager Navigation

<PageTitle>GetUriWithFragment()</PageTitle>

<h1>Navigation Features</h1>

<p>New navigation features in .NET 11 Preview 1.</p>

<h2 id="get-uri-with-hash">GetUriWithFragment()</h2>
<p>Construct URIs with hash fragments efficiently.</p>

<div class="mb-3">
    <p><strong>URI with fragment "get-uri-with-hash":</strong> @Navigation.GetUriWithFragment("get-uri-with-hash")</p>
    <p><strong>URI with fragment "code-example":</strong> @Navigation.GetUriWithFragment("code-example")</p>
</div>

<div class="nav nav-pills mb-3">
    <a href="@Navigation.GetUriWithFragment("get-uri-with-hash")" class="nav-link">Jump to GetUriWithFragment()</a>
    <a href="@Navigation.GetUriWithFragment("code-example")" class="nav-link">Jump to Code Example</a>
</div>

<h2 id="code-example">Code Example</h2>
<pre><code>
// GetUriWithFragment - construct URI with hash fragment
var uri = Navigation.GetUriWithFragment("section-1");
// Results in: /current-page#section-1</code></pre>
