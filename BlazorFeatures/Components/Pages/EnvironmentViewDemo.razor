@page "/environment-view"
@rendermode InteractiveServer

<PageTitle>EnvironmentView Demo</PageTitle>

<h1>EnvironmentView Component</h1>

<p>The <code>EnvironmentView</code> component conditionally renders content based on the hosting environment.</p>

<h2>Current Environment</h2>
<p>Your app is running in: <strong>@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</strong></p>

<h2>Demo</h2>

<h3>Include="Development"</h3>
<EnvironmentView Include="Development">
    <div class="alert alert-warning">
        ⚠️ Debug mode enabled - This only shows in Development
    </div>
</EnvironmentView>

<h3>Include="Development,Staging"</h3>
<EnvironmentView Include="Development,Staging">
    <div class="alert alert-info">
        ℹ️ Pre-production environment - Shows in Development or Staging
    </div>
</EnvironmentView>

<h3>Exclude="Production"</h3>
<EnvironmentView Exclude="Production">
    <div class="alert alert-secondary">
        🕐 Current time: @DateTime.Now.ToString("HH:mm:ss") - Hidden in Production
    </div>
</EnvironmentView>

<h3>Include="Production"</h3>
<EnvironmentView Include="Production">
    <div class="alert alert-success">
        ✅ Production environment - Only shows in Production
    </div>
</EnvironmentView>

@code {
    // No code needed - EnvironmentView uses IHostEnvironment internally
}
