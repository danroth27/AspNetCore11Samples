@page "/async-validation"
@rendermode InteractiveServer
@using BlazorFeatures.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BlazorFeatures.Resources.ValidationMessages> L
@implements IDisposable

<PageTitle>@L["RegisterPageTitle"]</PageTitle>

<h1>@L["RegisterFormTitle"]</h1>

<CultureSwitcher />

@*
    Async validation with plain DataAnnotations (.NET 11).

    There is no validation code in this component. The async uniqueness rules are
    [UniqueUsername] / [UniqueEmail] on RegistrationModel - AsyncValidationAttribute
    subclasses that await a service lookup, exactly like the ones ApiFeatures uses
    for minimal APIs. <DataAnnotationsValidator /> runs them per-field as the user
    edits and again for the whole model on submit, and <EditForm /> awaits
    EditContext.ValidateAsync() before invoking OnValidSubmit.

    The only thing this component does with the EditContext is *observe* it:
      - editContext.IsValidationPending(() => field) drives the per-field spinner
      - editContext.IsValidationFaulted(() => field) surfaces handler exceptions
      - editContext.IsValidationPending() (no field) is true while any check is in
        flight, which is what disables the submit button.

    Username/Email use the standard InputText binding, so each async check runs when
    the field changes (tab or click away) rather than on every keystroke. If a field
    is edited again while its check is still running, the framework cancels the
    in-flight task and only the latest result is applied.
*@
<div class="form-card">
<EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @* Not disabled after success: editing any field clears the success state, so the
       same form can be re-submitted without a page reload. *@
    <fieldset>
        <div class="form-group">
            <label for="username">@L["Username"]</label>
            <InputText id="username" class="form-control" @bind-Value="model.Username" placeholder="@L["UsernamePlaceholder"]" />
            <AsyncFieldStatus For="() => model.Username"
                              PendingMessage="@L["CheckingMessage"]"
                              FaultedMessage="@L["FaultedMessage"]"
                              AvailableMessage="@L["AvailableMessage"]" />
        </div>

        <div class="form-group">
            <label for="email">@L["Email"]</label>
            <InputText id="email" class="form-control" @bind-Value="model.Email" placeholder="@L["EmailPlaceholder"]" />
            <AsyncFieldStatus For="() => model.Email"
                              PendingMessage="@L["CheckingMessage"]"
                              FaultedMessage="@L["FaultedMessage"]"
                              AvailableMessage="@L["AvailableMessage"]" />
        </div>

        <div class="form-group">
            <label for="age">@L["Age"]</label>
            <InputNumber id="age" class="form-control" @bind-Value="model.Age" placeholder="@L["AgePlaceholder"]" />
            <ValidationMessage For="() => model.Age" />
        </div>

        <div class="form-group">
            <label for="website">
                @L["Website"] <span class="optional-label">@L["OptionalLabel"]</span>
            </label>
            <InputText id="website" class="form-control" @bind-Value="model.Website" placeholder="@L["WebsitePlaceholder"]" />
            <ValidationMessage For="() => model.Website" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@editContext.IsValidationPending()">
            @if (editContext.IsValidationPending())
            {
                <text>@L["SubmittingButton"]</text>
            }
            else if (submittedSuccessfully)
            {
                <text>@L["SubmittedSuccessfullyButton"]</text>
            }
            else
            {
                <text>@L["RegisterSubmitButton"]</text>
            }
        </button>

        @if (submittedSuccessfully)
        {
            <div class="alert alert-success mt-3">@L["RegisterSuccessMessage"]</div>
        }

        <ValidationSummary />
    </fieldset>
</EditForm>
</div>

@code {
    private RegistrationModel model = new();
    private EditContext editContext = default!;
    private bool submittedSuccessfully;

    protected override void OnInitialized()
    {
        editContext = new EditContext(model);
        editContext.OnValidationStateChanged += OnValidationStateChanged;
        editContext.OnFieldChanged += OnFieldChanged;
    }

    public void Dispose()
    {
        editContext.OnValidationStateChanged -= OnValidationStateChanged;
        editContext.OnFieldChanged -= OnFieldChanged;
    }

    // Re-render when validation state changes so the pending/faulted UI keeps up
    // with async checks completing on a background continuation.
    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        // EditContext events are plain .NET events, so ask for a re-render explicitly.
        submittedSuccessfully = false;
        InvokeAsync(StateHasChanged);
    }

    // Only runs once every rule - including the awaited uniqueness checks - has passed.
    private void HandleValidSubmit() => submittedSuccessfully = true;
}
