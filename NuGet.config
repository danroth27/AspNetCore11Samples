<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- .NET 11 Preview 7 packages (QuickGrid, Components.Server.AutoPause,
         Components.Gateway) are not on nuget.org until the preview ships, so the
         daily-build feed is added here. Remove this file once Preview 7 is on nuget.org. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
</configuration>
